---
import { coreVersion } from "../../lib/version";
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>
      <strong>toonstrip</strong> <span class="mono">v{coreVersion}</span> · {t("footer.license")} ·
      <a href="https://github.com/dkdev24/toonstrip">{t("footer.github")}</a> ·
      <a href="https://www.npmjs.com/org/toonstrip">{t("footer.npm")}</a> ·
      <a href="https://danielkimdev.com">danielkimdev.com</a>
    </p>
    <p class="site-footer__notice">
      {t("footer.notice")} <a href="https://github.com/dkdev24/toonstrip/blob/main/NOTICE">{t("footer.noticeLinkLabel")}</a>{t("footer.noticeSuffix")}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-96);
    border-top: 1px solid var(--rule);
    padding: var(--space-32) 0;
    font-size: var(--text-small);
    color: var(--ink-2);
  }
  .site-footer__inner p {
    margin: 0 0 var(--space-8);
  }
  .site-footer__notice {
    font-size: var(--text-caption);
    color: var(--ink-3);
    max-width: 68ch;
  }
</style>
