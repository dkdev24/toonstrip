---
/**
 * No-flash theme resolver. Render first inside <head>, before stylesheets.
 * Same contract as danielkimdev.com (DESIGN.md §9):
 *   localStorage `theme` = 'light' | 'dark'  →  <html data-theme="...">
 *   fallback: prefers-color-scheme. The toggle sets both.
 */
---

<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem("theme");
      var theme =
        stored === "light" || stored === "dark"
          ? stored
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
      document.documentElement.dataset.theme = theme;
    } catch (e) {
      document.documentElement.dataset.theme = "light";
    }
  })();
</script>
