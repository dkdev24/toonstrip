---
/** Field tables generated from schema.json (lib/schema-ref.ts). */
import { schemaReference } from "../../lib/schema-ref";
const types = schemaReference();
---

{types.map((t) => (
  <section class="schema-type">
    <h2 id={t.name.toLowerCase()}><code>{t.name}</code></h2>
    {t.values ? (
      <p>One of: {t.values.map((v, i) => <><code>{v}</code>{i < t.values!.length - 1 ? ", " : ""}</>)}</p>
    ) : (
      <div class="table-scroll" tabindex="0" role="region" aria-label={`${t.name} fields`}>
      <table>
        <thead>
          <tr><th scope="col">Field</th><th scope="col">Type</th><th scope="col">Required</th><th scope="col">Description</th></tr>
        </thead>
        <tbody>
          {t.rows.map((r) => (
            <tr>
              <td><code>{r.name}</code></td>
              <td><code>{r.type}</code></td>
              <td>{r.required ? "yes" : "no"}</td>
              <td>{r.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    )}
  </section>
))}

<style>
  .schema-type {
    margin-top: var(--space-32);
  }
  .table-scroll {
    overflow-x: auto;
    margin-bottom: var(--space-24);
  }
  .table-scroll table {
    margin: 0;
    min-width: 36rem;
  }
  .schema-type td:nth-child(2) {
    white-space: nowrap;
  }
</style>
