---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { getLocalizedPath, useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;
const items = [
  { href: getLocalizedPath("/docs/", lang), label: t("nav.docs") },
  { href: getLocalizedPath("/playground/", lang), label: t("nav.playground") },
  { href: getLocalizedPath("/changelog/", lang), label: t("nav.changelog") },
];
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container container--wide site-header__inner">
    <a class="wordmark" href={getLocalizedPath("/", lang)}>
      <span class="wordmark__glyph" aria-hidden="true"></span>
      toonstrip
    </a>
    <nav aria-label={t("nav.primaryAria")}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__tools">
      <a class="icon-link" href="https://github.com/dkdev24/toonstrip" aria-label={t("nav.githubAria")}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z" />
        </svg>
      </a>
      <LanguageToggle lang={lang} />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-24);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .wordmark__glyph {
    width: 12px;
    height: 12px;
    background: var(--accent);
    border: 2px solid var(--ink);
  }
  nav {
    flex: 1;
  }
  nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    padding: var(--space-4) var(--space-12);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  nav a:hover {
    color: var(--ink);
    background: var(--paper-sunken);
  }
  nav a[aria-current="page"] {
    color: var(--ink);
    background: var(--accent-soft);
  }
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .icon-link {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    color: var(--ink-2);
  }
  .icon-link:hover {
    background: var(--paper-sunken);
    color: var(--ink);
  }
  @media (max-width: 400px) {
    .icon-link {
      display: none;
    }
  }
</style>
