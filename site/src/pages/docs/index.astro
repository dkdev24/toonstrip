---
import Base from "../../layouts/Base.astro";
import { docsNav } from "../../lib/docs-nav";
import { useTranslations, type Lang, type TranslationKey } from "../../i18n/utils";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const { sections } = await docsNav(lang);
---

<Base title={t("docs.indexTitle")} description={t("docs.indexDescription")} lang={lang}>
  <div class="prose">
    <p class="caption">{t("docs.indexCaption")}</p>
    <h1>{t("docs.indexTitle")}</h1>
    <p class="lead">{t("docs.indexLead")}</p>
  </div>
  <div class="docs-index">
    {sections.map((s) => (
      <section class="docs-index__section">
        <h2>{t(`docs.section.${s.name}` as TranslationKey)}</h2>
        <ul>
          {s.entries.map((e) => (
            <li>
              <a href={e.href}>{e.title}</a>
              <p>{e.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .docs-index {
    display: grid;
    gap: var(--space-32);
    margin-top: var(--space-32);
  }
  @media (min-width: 900px) {
    .docs-index {
      grid-template-columns: 1fr 1fr;
    }
  }
  .docs-index__section h2 {
    font-size: var(--text-h3);
  }
  .docs-index ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .docs-index li {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--rule);
  }
  .docs-index li a {
    font-weight: 500;
  }
  .docs-index li p {
    margin: var(--space-4) 0 0;
    font-size: var(--text-small);
    color: var(--ink-2);
  }
</style>
