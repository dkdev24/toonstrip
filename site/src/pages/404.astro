---
import Base from "../layouts/Base.astro";
import { useTranslations, getLocalizedPath, type Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

<Base title={t("notFound.title")} description={t("notFound.description")} lang={lang}>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <div class="prose">
    <h1>{t("notFound.title")}</h1>
    <p class="lead">{t("notFound.body")}</p>
    <p>
      <a href={getLocalizedPath("/docs/", lang)}>{t("nav.docs")}</a> ·
      <a href={getLocalizedPath("/playground/", lang)}>{t("nav.playground")}</a>
    </p>
  </div>
</Base>
