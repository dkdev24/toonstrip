---
import { getCollection, render } from "astro:content";
import Docs from "../../../layouts/Docs.astro";
import { docLang, docSlug } from "../../../lib/docs-nav";
import { faqJsonLd } from "../../../lib/faq-schema";

export async function getStaticPaths() {
  const all = await getCollection("docs");
  const enEntries = all.filter((e) => docLang(e) === "en");
  return enEntries.map((enEntry) => {
    const slug = docSlug(enEntry);
    const koEntry = all.find((e) => docLang(e) === "ko" && docSlug(e) === slug);
    return { params: { slug }, props: { entry: koEntry ?? enEntry, fallback: !koEntry } };
  });
}

const { entry, fallback } = Astro.props;
const { Content, headings } = await render(entry);
const slug = docSlug(entry);
// FAQPage JSON-LD, derived from the curated ## question format of faq.mdx
const jsonLd = slug === "faq" ? faqJsonLd(entry.body) : null;
---

<Docs entry={entry} headings={headings} lang="ko" fallback={fallback}>
  {jsonLd && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={jsonLd} />
    </Fragment>
  )}
  <Content />
</Docs>
