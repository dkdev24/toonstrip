---
/**
 * Design check page (SITE_DEV_PLAN.md §10 S1): every DESIGN.md §5 component in
 * one place, excluded from the sitemap and robots. Not linked from the site.
 */
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/site/CodeBlock.astro";
import Callout from "../components/site/Callout.astro";
import PackageManagerTabs from "../components/site/PackageManagerTabs.astro";
import CodeAndStrip from "../components/demo/CodeAndStrip.astro";
import WidthSlider from "../components/demo/WidthSlider.astro";
import hero from "../content/strips/hero.json";
import korean from "../content/strips/korean.json";
import type { ComicStripDocument } from "@toonstrip/schema";

const doc = hero as ComicStripDocument;
---

<Base title="Kitchen sink" description="Component check page." wide>
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>
  <div class="prose">
    <p class="caption">Design check</p>
    <h1>Kitchen sink</h1>
    <p class="lead">Every shared component, both themes, for axe and eyeballs.</p>

    <h2>Type</h2>
    <p style="font-size: var(--text-hero); font-family: var(--font-display); font-weight: 700; line-height: 1.05">Hero display</p>
    <h1>Heading one</h1>
    <h2>Heading two</h2>
    <h3>Heading three</h3>
    <p>Body text at 17 px with a <a href="#">link</a>, some <code>inline code</code>, and <strong>bold</strong>. Measure stays under 68 characters so lines read comfortably.</p>
    <p class="small" style="font-size: var(--text-small)">Small text for secondary copy.</p>
    <p class="caption">Caption label</p>

    <h2>Buttons</h2>
    <p style="display:flex; gap: var(--space-12); flex-wrap: wrap">
      <button class="button button--primary">Primary</button>
      <button class="button button--secondary">Secondary</button>
      <button class="button button--ghost">Ghost</button>
      <button class="button button--danger">Remove</button>
      <button class="button button--primary" disabled>Disabled</button>
    </p>
    <p style="display:flex; gap: var(--space-8); flex-wrap: wrap">
      <button class="chip" aria-pressed="true">Selected chip</button>
      <button class="chip" aria-pressed="false">Chip</button>
      <span class="badge">core 0.1.6</span>
    </p>

    <h2>Callouts</h2>
    <Callout>A note, drawn as a comic caption box.</Callout>
    <Callout kind="tip" title="Tip">Use <code>client:visible</code> for strips below the fold.</Callout>
    <Callout kind="warning">Pack ids must be unique across registered packs.</Callout>
    <Callout kind="danger">This removes the panel and its lines.</Callout>

    <h2>Code</h2>
    <PackageManagerTabs packages={["@toonstrip/astro", "@toonstrip/pack-comic-chat"]} />
    <CodeBlock lang="astro" title="src/pages/index.astro" code={`---\nimport { ComicStrip } from "@toonstrip/astro";\nimport doc from "../content/strip.json";\n---\n<ComicStrip document={doc} packs={["comic-chat"]} client:visible />`} />

    <h2>Table</h2>
    <table>
      <thead><tr><th>Field</th><th>Type</th><th>Required</th></tr></thead>
      <tbody>
        <tr><td><code>backdrop</code></td><td>string</td><td>yes</td></tr>
        <tr><td><code>camera</code></td><td>CameraPreset</td><td>no</td></tr>
        <tr><td><code>dark</code></td><td>boolean</td><td>no</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Cards</h2>
  <div class="grid grid--3">
    <div class="card"><div class="card__media"><div style="height:80px"></div></div><h3>You write data</h3><p>Panels, characters, and lines as JSON.</p></div>
    <div class="card"><div class="card__media"><div style="height:80px"></div></div><h3>A pack supplies the art</h3><p>Fifteen characters and three backdrops out of the box.</p></div>
    <div class="card"><div class="card__media"><div style="height:80px"></div></div><h3>It renders live</h3><p>Canvas, DPR-aware, reflows, accessible.</p></div>
  </div>

  <h2 style="margin-top: var(--space-48)">CodeAndStrip</h2>
  <CodeAndStrip doc={doc} title="Hero strip, collapsed" collapse load="load" />
  <CodeAndStrip doc={doc} title="Hero strip, side layout" layout="side" load="load" />

  <h2>WidthSlider</h2>
  <WidthSlider doc={doc} load="load" />

  <h2>Korean balloon text</h2>
  <p>Hangul must render in Noto Sans KR (loaded by the page), never a brush script. Latin in the same balloon stays Comic Sans.</p>
  <CodeAndStrip doc={korean as ComicStripDocument} title="Korean strip" layout="side" load="load" />
</Base>
