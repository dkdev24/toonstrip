{
  "name": "@toonstrip/next",
  "version": "0.1.1",
  "description": "[DEPRECATED] @toonstrip/react's <ComicStrip> now carries its own 'use client' directive and @toonstrip/cli exports renderPlaceholder directly — import from those instead. See docs/next.md for the migration.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@toonstrip/cli": "workspace:*",
    "@toonstrip/react": "workspace:*"
  },
  "devDependencies": {
    "@toonstrip/schema": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "toonstrip",
    "comic",
    "next",
    "nextjs",
    "ssr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkdev24/toonstrip.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/dkdev24/toonstrip#readme",
  "bugs": "https://github.com/dkdev24/toonstrip/issues"
}
