{
  "name": "@toonstrip/cli",
  "version": "0.2.0",
  "description": "Command-line tool for toonstrip: validate asset packs and render a Comic Strip Document to PNG.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "toonstrip": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@toonstrip/pack-comic-chat": "workspace:*",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "toonstrip",
    "comic",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkdev24/toonstrip.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/dkdev24/toonstrip#readme",
  "bugs": "https://github.com/dkdev24/toonstrip/issues",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@toonstrip/core": "workspace:*",
    "@toonstrip/schema": "workspace:*"
  }
}
