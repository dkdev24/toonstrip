{
  "name": "@toonstrip/schema",
  "version": "0.1.3",
  "description": "ComicStripDocument v1 types, JSON Schema, and a runtime validator for toonstrip.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/schema.json"
  ],
  "scripts": {
    "prebuild": "node scripts/embed-schema.mjs",
    "build": "tsc -p tsconfig.json",
    "pretest": "node scripts/embed-schema.mjs",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "toonstrip",
    "comic",
    "schema",
    "validation",
    "json-schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkdev24/toonstrip.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/dkdev24/toonstrip#readme",
  "bugs": "https://github.com/dkdev24/toonstrip/issues"
}
