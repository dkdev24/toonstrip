{
  "name": "@toonstrip/react",
  "version": "0.1.2",
  "description": "<ComicStrip>, a thin React wrapper around @toonstrip/element's <comic-strip> custom element.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
